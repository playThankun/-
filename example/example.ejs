        display: flex;
        align-items: center;
        gap: 7px;
    }

    .toolbar-file input[type="file"] {
        display: none;
    }

    .file-button {
        height: 36px;
        padding: 0 13px;

        display: inline-flex;
        align-items: center;
        gap: 7px;

        border: 1px solid #dfe3e8;
        border-radius: 9px;

        background: #fff;
        color: #333;

        font-size: 13px;
        font-weight: 600;

        cursor: pointer;
        transition: 0.15s ease;
    }

    .file-button:hover {
        background: #f7f8fa;
        border-color: #cfd5dc;
        transform: translateY(-1px);
    }

