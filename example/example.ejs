                                                        '';

                                                    let quoted =
                                                        false;


                                                    for (
                                                        let i = 0;
                                                        i < line.length;
                                                        i++
                                                    ) {

                                                        const ch =
                                                            line[i];


                                                        if (
                                                            ch ===
                                                            '"'
