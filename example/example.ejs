            function bickleAsset(value) {
                if(typeof value!=='string') return null;
                const m=value.match(/\/uploads\/(.+)$/);
                if(m) return {url:value,path:m[1]};
                if(value.startsWith('uploads/')) return {url:'https://playentry.org/'+value,path:value.slice(8)};
                if(value.startsWith('/uploads/')) return {url:'https://playentry.org'+value,path:value.slice(9)};
                return null;
            }

            function bickleFindAssets(value,map=new Map()) {
                if(value==null) return map;
                if(typeof value==='string'){const a=bickleAsset(value);if(a)map.set(a.url,a.path);return map;}
                if(Array.isArray(value)){value.forEach(v=>bickleFindAssets(v,map));return map;}
                if(typeof value==='object')Object.values(value).forEach(v=>bickleFindAssets(v,map));
