                                            const reader =
                                                new FileReader();


                                            reader.onload =
                                                () => {

                                                    const ext =
                                                        (
                                                            file.name
                                                                .split('.')
                                                                .pop() ||
                                                            'png'
                                                        ).toLowerCase();


                                                    const fileurl =
                                                        reader.result;


                                                    const img =
                                                        new Image();


                                                    img.onload =
                                                        () => {

                                                            resolve({

                                                                id:
                                                                    Entry.generateHash(),

                                                                name:
                                                                    file.name,

                                                                label: {

                                                                    ko:
                                                                        file.name

                                                                },

                                                                filename:
                                                                    file.name,

                                                                fileurl,

                                                                imageType:
                                                                    ext,

                                                                dimension: {

                                                                    width:
                                                                        img.naturalWidth ||
                                                                        100,

                                                                    height:
                                                                        img.naturalHeight ||
                                                                        100

                                                                }

                                                            });

                                                        };


                                                    img.onerror =
                                                        () => {

                                                            resolve({

                                                                id:
                                                                    Entry.generateHash(),

                                                                name:
                                                                    file.name,

                                                                label: {

                                                                    ko:
                                                                        file.name

                                                                },

                                                                filename:
                                                                    file.name,

                                                                fileurl,

                                                                imageType:
                                                                    ext,

                                                                dimension: {

                                                                    width:
                                                                        100,

                                                                    height:
                                                                        100

                                                                }

                                                            });

                                                        };


                                                    img.src =
                                                        fileurl;

                                                };


                                            reader.readAsDataURL(
                                                file
                                            );

                                        }
                                    )

                            )

                        );


                    popup.setData({

                        data: {

                            uploads,

                            data: []

                        }

                    });

                } catch (err) {

                    console.error(
                        'dummyUploads 처리 실패',
                        err
                    );

                }

            }
        );


        /*
         * ========================================
         * Upload 완료
         * ========================================
         */

        popup.on(
            'uploads',
            (data) => {

                if (
                    currentType ===
                    'table'
                ) {

                    const uploads =
                        Array.isArray(data)
                            ? data
                            : (
                                data &&
                                Array.isArray(
                                    data.uploads
                                )
                                    ? data.uploads
                                    : []
                            );


                    uploads.forEach(
                        (tableItem) => {

                            if (
                                !tableItem ||
                                !Entry.playground?.dataTable
                            ) {

                                return;

                            }


                            Entry.playground.dataTable
                                .addSources(
                                    tableItem
                                );


                            Entry.creationChangedEvent
                                .notify();

                        }
                    );


                    return;

                }


                const uploads =
                    Array.isArray(data)
                        ? data
                        : (
                            data &&
                            Array.isArray(
                                data.uploads
                            )
                                ? data.uploads
                                : []
                        );


                if (uploads.length) {

                    applyItemsByType(
                        uploads
                    );

                }

            }
        );


        /*
         * ========================================
         * 업로드 실패
         * ========================================
         */

        popup.on(
            'uploadFail',
            (data) => {

                console.error(
                    'upload fail',
                    data
                );


                alert(
                    `${
                        data?.messageParent ||
                        ''
                    }${
                        data?.message ||
                        '업로드에 실패했습니다.'
                    }`
                );

            }
        );


        /*
         * ========================================
         * 글상자
         * ========================================
         */

        popup.on(
            'write',
            (data) => {

                const object = {

                    id:
                        Entry.generateHash(),

                    name:
                        '글상자',

                    text:
                        data.text,

                    options: {

                        font:
                            data.font,

                        bold:
                            false,

                        underLine:
                            false,

                        italic:
                            false,

                        strike:
                            (
                                data.effects &&
                                data.effects.through
                            ) ||
                            false,

                        colour:
                            (
                                data.effects &&
                                data.effects.color
                            ) ||
                            '#000000',

                        background:
                            (
                                data.effects &&
                                data.effects.backgroundColor
                            ) ||
                            '#ffffff',

                        lineBreak:
                            data.writeType !==
                            'one',

                        ...(
                            data.effects ||
                            {}
                        )

                    },

                    objectType:
                        'textBox',

                    sprite: {

                        sounds: [],

                        pictures: []

                    }

                };


                Entry.container.addObject(
                    object,
                    0
                );

            }
        );


        /*
         * ========================================
         * Entry Manager 이벤트
         * ========================================
         */


        /*
         * 오브젝트 추가
         */

        removeAllEventListener(
            'openSpriteManager'
        );


        addEventListener(
            'openSpriteManager',
            () => {

                currentType =
                    'sprite';


                popup.show(

                    {
                        type:
                            'sprite'
                    },

                    {

                        sidebar:
                            spriteSidebarData,

                        data: {

                            imageBaseUrl:
                                'https://playentry.org/uploads/',

                            data:
                                officialSpriteData

                        }

                    }

                );

            }
        );


        /*
         * 그림 추가
         */

        removeAllEventListener(
            'openPictureManager'
        );


        addEventListener(
            'openPictureManager',
            () => {

                currentType =
                    'picture';


                popup.show(

                    {
                        type:
                            'picture'
                    },

                    {

                        sidebar:
                            {},

                        data: {

                            imageBaseUrl:
                                '',

                            data:
                                []

                        }

                    }

                );

            }
        );


        /*
         * 소리 추가
         */

        removeAllEventListener(
            'openSoundManager'
        );


        addEventListener(
            'openSoundManager',
            () => {

                currentType =
                    'sound';


                popup.show(

                    {
                        type:
                            'sound'
                    },

                    {

                        sidebar:
                            {},

                        data: {

                            imageBaseUrl:
                                '',

                            data:
                                []

                        }

                    }

                );

            }
        );

    });
</script>
    </body>
</html>
