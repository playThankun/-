                                                            if (
                                                                quoted &&
                                                                line[i + 1] ===
                                                                    '"'
                                                            ) {

                                                                value +=
                                                                    '"';

                                                                i++;

                                                            } else {

                                                                quoted =
                                                                    !quoted;

                                                            }

                                                        } else if (
                                                            ch ===
                                                            ',' &&
                                                            !quoted
                                                        ) {

                                                            result.push(
                                                                value
                                                            );

                                                            value =
                                                                '';

                                                        } else {

                                                            value +=
                                                                ch;

                                                        }

                                                    }


                                                    result.push(
