        <script>
            function changeWorkspaceMode(mode) {
                const workspace = Entry.getMainWS();
                if (!workspace) return;

                const option = {};
                if (mode === 'block') {
                    option.boardType = Entry.Workspace.MODE_BOARD;
                    option.textType = -1;
                } else {
                    option.boardType = Entry.Workspace.MODE_VIMBOARD;
                    option.textType = Entry.Vim.TEXT_TYPE_PY;
                    option.runType = Entry.Vim.WORKSPACE_MODE;
                }

                workspace.setMode(option);
                document.getElementById('blockModeButton')?.classList.toggle('active', mode === 'block');
                document.getElementById('pythonModeButton')?.classList.toggle('active', mode === 'python');
            }

            /*
             * ========================================
             * Bickle Play Mode 갱신
             * ========================================
             *
             * play 모드로 전환된 뒤 Workspace/Canvas 크기를
             * 새 레이아웃(CSS)에 맞게 다시 계산시키고,
             * 정지/일시정지/좌표/최대화 툴바를 붙입니다.
             */
            function bickleToggleCoordinate(btn) {
                const mouseView = document.querySelector('.entryMouseViewWorkspace_w');
                if (mouseView) {
                    const showing = mouseView.style.display !== 'none';
                    mouseView.style.display = showing ? 'none' : '';
                }
            }

            function bickleRequestFullscreen() {
                const el = document.querySelector('.entryEngine_w') || document.body;
                if (el.requestFullscreen) {
                    el.requestFullscreen();
                } else if (document.fullscreenElement) {
                    document.exitFullscreen?.();
                }
            }

            function bickleTogglePause() {
                const btn = document.querySelector('.bickle-btn-pause');
                try {
                    if (typeof Entry.engine?.togglePause === 'function') {
                        Entry.engine.togglePause();
                    }
                } catch (e) {
                    console.warn('[Bickle Play Mode] pause 실패', e);
                }
                if (btn) btn.classList.toggle('paused');
            }

            function bickleStop() {
                try {
                    if (typeof Entry.engine?.toggleStop === 'function') {
                        Entry.engine.toggleStop();
                    }
                } catch (e) {
                    console.warn('[Bickle Play Mode] stop 실패', e);
                }
            }

            function applyBicklePlayerSkin() {
                try {
                    const workspace = Entry.getMainWS?.();
                    if (workspace) workspace.resize();
                } catch (e) {
                    console.warn('[Bickle Play Mode] resize 실패', e);
                }
                window.dispatchEvent(new Event('resize'));

                if (!document.querySelector('.bickle-player-bar')) {
                    const bar = document.createElement('div');
                    bar.className = 'bickle-player-bar';
                    bar.innerHTML = `
                        <button type="button" class="bickle-btn bickle-btn-stop" title="정지" onclick="bickleStop()"></button>
                        <button type="button" class="bickle-btn bickle-btn-pause" title="일시정지" onclick="bickleTogglePause()"></button>
                        <button type="button" class="bickle-btn bickle-btn-coordinate" title="좌표 보기" onclick="bickleToggleCoordinate(this)"></button>
                        <button type="button" class="bickle-btn bickle-btn-maximize" title="전체화면" onclick="bickleRequestFullscreen()"></button>
                    `;
                    const engineEl = document.querySelector('.entryEngine_w');
                    if (engineEl && engineEl.parentNode) {
                        engineEl.parentNode.insertBefore(bar, engineEl.nextSibling);
                    }
                }
            }

            const BICKLE_ENCODER = new TextEncoder();

            function bickleTarString(buf, offset, length, value) {
                buf.set(BICKLE_ENCODER.encode(String(value)).subarray(0, length), offset);
            }

            function bickleTarHeader(path, size) {
                const h = new Uint8Array(512);
                bickleTarString(h, 0, 100, path);
                bickleTarString(h, 100, 8, '0000644\0');
                bickleTarString(h, 108, 8, '0000000\0');
                bickleTarString(h, 116, 8, '0000000\0');
                bickleTarString(h, 124, 12, Math.floor(size).toString(8).padStart(11, '0') + '\0');
                bickleTarString(h, 136, 12, Math.floor(Date.now()/1000).toString(8).padStart(11, '0') + '\0');
                for (let i=148;i<156;i++) h[i]=0x20;
                h[156]=0x30;
                bickleTarString(h,257,6,'ustar\0');
                bickleTarString(h,263,2,'00');
                let sum=0; for (const b of h) sum+=b;
                bickleTarString(h,148,6,sum.toString(8).padStart(6,'0'));
                h[154]=0; h[155]=0x20;
                return h;
            }

            function bickleTarAdd(parts,path,data) {
                if (!(data instanceof Uint8Array)) data=new Uint8Array(data);
