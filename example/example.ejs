        <script>
    /*
     * ============================================
     * Bickle .ent 불러오기
     * ============================================
     */

    function bickleReadTarString(buf, start, length) {
        const bytes = buf.subarray(start, start + length);
        let end = bytes.indexOf(0);

        if (end === -1) {
            end = bytes.length;
        }

        return new TextDecoder().decode(bytes.subarray(0, end));
    }

    function bickleReadTarOctal(buf, start, length) {
        const text = bickleReadTarString(buf, start, length)
            .trim()
            .replace(/\0/g, '');

        return parseInt(text, 8) || 0;
    }

    function bickleParseTar(buffer) {
        const buf =
            buffer instanceof Uint8Array
                ? buffer
                : new Uint8Array(buffer);

        const files = new Map();

        let offset = 0;

        while (offset + 512 <= buf.length) {
            const header = buf.subarray(offset, offset + 512);

            // TAR 종료 블록
            let empty = true;

            for (let i = 0; i < 512; i++) {
                if (header[i] !== 0) {
                    empty = false;
                    break;
                }
            }

            if (empty) {
                break;
            }

            const name = bickleReadTarString(header, 0, 100);
            const size = bickleReadTarOctal(header, 124, 12);
            const type = header[156];

            offset += 512;

            if (offset + size > buf.length) {
                throw new Error(
                    '손상된 TAR 파일입니다.'
                );
            }

            const data = buf.slice(offset, offset + size);

            // 일반 파일만 처리
            if (type === 0 || type === 48) {
                files.set(name, data);
            }

            // 512 byte 단위 정렬
            offset += Math.ceil(size / 512) * 512;
        }

        return files;
    }

    function bickleReplaceAssetUrls(value, assetMap) {
        if (typeof value === 'string') {
            // 이미 data URL이면 그대로
            if (value.startsWith('data:')) {
                return value;
            }

            /*
             * 원래 엔트리 업로드 URL:
             *
             * https://playentry.org/uploads/aa/bb/image/xxx.png
             *
             * 또는
             *
             * /uploads/aa/bb/image/xxx.png
             */

            for (const [path, blobUrl] of assetMap.entries()) {
                const normalizedPath = path.replace(/^temp\//, '');

                if (
                    value.endsWith('/uploads/' + normalizedPath) ||
                    value === 'uploads/' + normalizedPath ||
                    value === '/uploads/' + normalizedPath ||
                    value.endsWith(normalizedPath)
                ) {
                    return blobUrl;
                }
            }

            return value;
        }

        if (Array.isArray(value)) {
            return value.map(item =>
                bickleReplaceAssetUrls(item, assetMap)
            );
        }

        if (value && typeof value === 'object') {
            for (const key of Object.keys(value)) {
                value[key] = bickleReplaceAssetUrls(
                    value[key],
                    assetMap
                );
            }
        }

        return value;
    }

    async function loadENT(file) {
        const btn = document.getElementById('entLoadButton');

        if (!file) {
            return;
        }

        try {
            btn.disabled = true;
            btn.textContent = '⏳ 불러오는 중...';

            if (!file.name.toLowerCase().endsWith('.ent')) {
                throw new Error(
                    '.ent 파일만 불러올 수 있습니다.'
                );
            }

            /*
             * 1. .ent 파일 읽기
             */
            const compressed = new Uint8Array(
                await file.arrayBuffer()
            );

            /*
             * 2. gzip 해제
             */
            if (typeof DecompressionStream === 'undefined') {
                throw new Error(
                    '이 브라우저는 gzip 압축 해제를 지원하지 않습니다.'
                );
            }

            const decompressedStream =
                new Blob([compressed])
                    .stream()
                    .pipeThrough(
                        new DecompressionStream('gzip')
                    );

            const tarBuffer =
                new Uint8Array(
                    await new Response(
                        decompressedStream
                    ).arrayBuffer()
                );

            /*
             * 3. TAR 해제
             */
            const files = bickleParseTar(tarBuffer);

            /*
             * 4. project.json 찾기
             */
            const projectFile =
                files.get('temp/project.json') ||
                files.get('project.json');

            if (!projectFile) {
                throw new Error(
                    'temp/project.json을 찾을 수 없습니다.'
                );
            }

            /*
             * 5. JSON 파싱
             */
            const projectText =
                new TextDecoder().decode(projectFile);

            const project =
                JSON.parse(projectText);

            /*
             * 6. 포함된 에셋들을 Blob URL로 생성
             */
            const assetMap = new Map();

            for (const [path, data] of files.entries()) {
                if (path === 'temp/project.json') {
                    continue;
                }

                if (!path.startsWith('temp/')) {
                    continue;
                }

                const assetPath =
                    path.substring(5);

                /*
                 * 확장자에 따른 MIME 타입
                 */
                const ext =
                    assetPath
                        .split('.')
                        .pop()
                        ?.toLowerCase();

                const mimeMap = {
                    png: 'image/png',
                    jpg: 'image/jpeg',
                    jpeg: 'image/jpeg',
                    gif: 'image/gif',
                    webp: 'image/webp',
                    svg: 'image/svg+xml',
                    mp3: 'audio/mpeg',
                    wav: 'audio/wav',
                    ogg: 'audio/ogg',
                    m4a: 'audio/mp4',
                    mp4: 'video/mp4',
                    webm: 'video/webm'
                };

                const mime =
                    mimeMap[ext] ||
                    'application/octet-stream';

                const blob =
                    new Blob([data], {
                        type: mime
                    });

                const blobUrl =
                    URL.createObjectURL(blob);

                assetMap.set(
                    assetPath,
                    blobUrl
                );
            }

            /*
             * 7. 프로젝트 내부의
             *    /uploads/... URL을 Blob URL로 교체
             */
            const projectForLoad =
                bickleReplaceAssetUrls(
                    project,
                    assetMap
                );

            /*
             * 8. EntryJS에 프로젝트 로드
             */
            if (
                typeof Entry?.loadProject !== 'function'
            ) {
                throw new Error(
                    'Entry.loadProject()를 찾을 수 없습니다.'
                );
            }
            Entry.clearProject();
Entry.loadProject(projectForLoad);

